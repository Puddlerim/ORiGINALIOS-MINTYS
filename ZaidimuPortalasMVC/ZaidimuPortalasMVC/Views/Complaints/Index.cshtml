@model IReadOnlyList<ZaidimuPortalasMVC.Models.Complaint>

@{
    ViewData["Title"] = "Skundų sąrašas";
    var reviews = (List<ZaidimuPortalasMVC.Models.Review>)ViewBag.Reviews;
}

<h1>Skundų sąrašas</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Skundų nėra.</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Pateikimo data</th>
                <th>Pateikė</th>
                <th>Žaidimas</th>
                <th>Priežastis</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var skundas in Model)
            {
                var review = reviews.FirstOrDefault(r => r.Id == skundas.ReviewId);
                <tr>
                    <td>@skundas.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td>@skundas.Username</td>
                    <td>@(review?.GameName ?? "(atsiliepimas nerastas)")</td>
                    <td>@skundas.Reason</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-primary"
                           asp-action="Details"
                           asp-route-id="@skundas.Id">Peržiūrėti</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
