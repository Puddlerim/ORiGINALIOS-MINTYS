@{
    ViewData["Title"] = "Mano profilis";
}

<div class="container mt-5">
    <h1>Mano profilis</h1>

    <div class="text-center mt-4 mb-4">
        <img src="https://ui-avatars.com/api/?name=User&size=150"
             alt="Profilio nuotrauka"
             class="rounded-circle border"
             width="150"
             height="150" />
    </div>

    <hr/>

    <h3>Sveiki, @User.Identity?.Name!</h3>

    <p>MI BOMBOOOOOOOOO</p>
</div>

<a asp-controller="PersonalList"
   asp-action="Index"
   class="btn btn-primary mt-3">
    Mano žaidimų sąrašas
</a>

<a asp-area="Identity"
   asp-page="/Account/Manage/Index"
   class="btn btn-secondary mt-3">
    Paskyros nustatymai
</a>