@{
    ViewData["Title"] = "Mano žaidimų sąrašas";
}

<div class="container mt-4">

    <h1>Mano žaidimų sąrašas</h1>

    <hr />

    <p>Čia bus rodomi žaidimai, kuriuos pridėjote į savo sąrašą.</p>

    <a asp-controller="PersonalList"
       asp-action="Statistics"
       class="btn btn-primary">
        Statistika
    </a>

    <a asp-controller="PersonalList"
       asp-action="Edit"
       class="btn btn-warning">
        Redaguoti
    </a>

    <a asp-controller="Reports"
       asp-action="Index"
       class="btn btn-info">
        Žaidimų duomenų ataskaita
    </a>

    <h3 class="mt-5">Mano žaidimai</h3>

    <div class="card mt-3 shadow-sm">
        <div class="card-body">

            @foreach (var game in Model)
            {
                <div class="card mt-3 shadow-sm">
                    <div class="card-body">

                        <h4>@game.Pavadinimas</h4>

                        <p>
                            <strong>Žanras:</strong>
                            @string.Join(", ", game.Zanrai)
                        </p>

                        <p>
                            <strong>Platformos:</strong>
                            @string.Join(", ", game.Platformos)
                        </p>

                        <p>
                            <strong>Kūrėjas:</strong> @game.Kurejas
                        </p>

                        <hr />

                        <a asp-controller="PersonalList"
                           asp-action="PlayTime"
                           asp-route-id="@game.Id"
                           class="btn btn-success">
                            Įvesti žaidimo laiką
                        </a>

                    </div>
                </div>
            }

        </div>
    </div>

    <div id="gamesList" class="row mt-3">
    </div>
</div>