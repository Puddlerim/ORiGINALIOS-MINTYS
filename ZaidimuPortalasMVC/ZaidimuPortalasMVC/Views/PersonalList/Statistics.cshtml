@model List<ZaidimuPortalasMVC.Models.Game>
@{
    ViewData["Title"] = "Asmeninio sąrašo statistika";
}

<div class="container mt-4">

    <h1>Mano žaidimų statistika</h1>
    <hr />

    <p>Čia pateikiama viso asmeninio žaidimų sąrašo statistika.</p>

    <div class="row mt-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Žaidimų skaičius</h5>
                    <h2>@Model.Count</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Bendras žaidimo laikas</h5>
                    <h2>240 val.</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5>Vidutinis žaidimo laikas</h5>
                    <h2>120 val.</h2>
                </div>
            </div>
        </div>

    </div>

    <a asp-controller="PersonalList"
       asp-action="Index"
       class="btn btn-secondary mt-3">
        Grįžti į mano žaidimų sąrašą
    </a>

</div>