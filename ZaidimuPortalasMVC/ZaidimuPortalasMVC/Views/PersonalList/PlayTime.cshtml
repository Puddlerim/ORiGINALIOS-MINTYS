@model ZaidimuPortalasMVC.Models.Game
@{
    ViewData["Title"] = "Žaidimo laiko įvedimas";
}

<div class="container mt-4">

    <h1>Žaidimo laiko įvedimas</h1>
    <hr />

    <div class="card shadow-sm">
        <div class="card-body">

            <h4>@Model.Pavadinimas</h4>

            <p><strong>Dabartinis žaidimo laikas:</strong> 120 val.</p>

            <div class="mb-3">
                <label class="form-label">Naujas žaidimo laikas (valandomis)</label>

                <input type="number"
                       class="form-control"
                       placeholder="Pvz., 150"
                       min="0" />
            </div>

            <button type="button" class="btn btn-success">
                Išsaugoti
            </button>

            <a asp-controller="PersonalList"
               asp-action="Index"
               class="btn btn-secondary">
                Atgal
            </a>

        </div>
    </div>

</div> 