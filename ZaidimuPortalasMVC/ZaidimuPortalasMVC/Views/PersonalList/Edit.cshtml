@model List<ZaidimuPortalasMVC.Models.Game>
@{
    ViewData["Title"] = "Asmeninio sąrašo redagavimas";
}

<div class="container mt-4">

    <h1>Asmeninio žaidimų sąrašo redagavimas</h1>
    <hr />

    <p>Šiame puslapyje galite tvarkyti savo asmeninį žaidimų sąrašą.</p>

    @foreach (var game in Model)
    {
        <div class="card shadow-sm mt-4">
            <div class="card-body">

                <h4>@game.Pavadinimas</h4>

                <p>
                    <strong>Žanras:</strong>
                    @string.Join(", ", game.Zanrai)
                </p>

                <p>
                    <strong>Platformos:</strong>
                    @string.Join(", ", game.Platformos)
                </p>

                <p>
                    <strong>Kūrėjas:</strong> @game.Kurejas
                </p>

                <button type="button" class="btn btn-danger">
                    Pašalinti iš sąrašo
                </button>

            </div>
        </div>
    }

    <a asp-controller="PersonalList"
       asp-action="Index"
       class="btn btn-secondary mt-4">
        Grįžti į mano žaidimų sąrašą
    </a>

</div>