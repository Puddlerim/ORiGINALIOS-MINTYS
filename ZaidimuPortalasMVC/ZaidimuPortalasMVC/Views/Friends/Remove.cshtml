@model RemoveFriendViewModel
@{
    ViewData["Title"] = "Draugo pašalinimo patvirtinimas";
}

<div class="container py-4" style="max-width: 650px;">
    <a asp-controller="Friends" asp-action="Index" class="d-inline-block mb-3">← Grįžti į draugų sąrašą</a>
    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h1 class="h3">Draugo pašalinimo patvirtinimas</h1>
            <p class="mt-3">Ar tikrai norite pašalinti <strong>@Model.DisplayName (@Model.Username)</strong> iš draugų sąrašo?</p>
            <p class="text-muted" id="password-help">Patvirtinkite veiksmą įvesdami savo paskyros slaptažodį.</p>

            <form asp-controller="Friends" asp-action="Remove" asp-route-id="@Model.Id" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password"
                           aria-describedby="password-help password-error" required />
                    <span asp-validation-for="Password" id="password-error" class="text-danger" role="alert"></span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-controller="Friends" asp-action="Index" class="btn btn-outline-secondary">Atšaukti</a>
                    <button type="submit" class="btn btn-danger">Pašalinti draugą</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
